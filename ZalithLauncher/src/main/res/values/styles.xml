<?xml version="1.0" encoding="utf-8"?>
<!--
    FlintLauncher styles.xml
    Place at: ZalithLauncher/src/main/res/values/styles.xml
    Also copy to: ZalithLauncher/src/main/res/values-night/styles.xml

    IMPORTANT: Keeps all original ZalithLauncher styles so nothing breaks.
    Only AppTheme, CustomDialogStyle and CustomAlertDialogTheme are updated.
-->
<resources>

    <!-- ── Main App Theme (Dark always) ── -->
    <style name="AppTheme" parent="@style/Theme.AppCompat.NoActionBar">
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:statusBarColor">@color/flint_bg</item>
        <item name="android:navigationBarColor">@color/flint_bg</item>
        <item name="android:windowBackground">@color/flint_bg</item>
        <item name="android:scrollbarThumbHorizontal">@color/flint_accent</item>
        <item name="android:scrollbarThumbVertical">@color/flint_accent</item>
        <item name="android:textSize">@dimen/_12ssp</item>
        <item name="android:textColor">@color/flint_text</item>
        <item name="android:fontFamily">@font/exo2</item>
    </style>

    <!-- ── Splash Screen Theme ── -->
    <style name="SplashTheme" parent="@style/Theme.AppCompat.NoActionBar">
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:statusBarColor">@color/flint_bg</item>
        <item name="android:navigationBarColor">@color/flint_bg</item>
        <item name="android:windowBackground">@color/flint_bg</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <!-- ── Dialogs ── -->
    <style name="CustomDialogStyle" parent="Theme.AppCompat.Dialog">
        <item name="android:windowBackground">@drawable/flint_bg_dialog</item>
        <item name="android:scrollbarThumbHorizontal">@color/flint_accent</item>
        <item name="android:scrollbarThumbVertical">@color/flint_accent</item>
        <item name="android:textColor">@color/flint_text</item>
    </style>

    <style name="CustomAlertDialogTheme" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@drawable/flint_bg_dialog</item>
        <item name="android:scrollbarThumbHorizontal">@color/flint_accent</item>
        <item name="android:scrollbarThumbVertical">@color/flint_accent</item>
        <item name="android:textColor">@color/flint_text</item>
    </style>

    <!-- ── KEEP ORIGINAL — required by existing layouts ── -->
    <style name="RoundedCornersImageView">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">4%</item>
    </style>

    <style name="RoundImageView">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

</resources>
