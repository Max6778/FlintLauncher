<?xml version="1.0" encoding="utf-8"?>
<!--
    FlintLauncher colors.xml
    Place at: ZalithLauncher/src/main/res/values/colors.xml
    This replaces the original ZalithLauncher colors entirely.
    Light launcher palette; dark mode values are defined in values-night/colors_night.xml.
-->
<resources>
