<?xml version="1.0" encoding="utf-8"?>
<!--
    FlintLauncher colors.xml
    Place at: ZalithLauncher/src/main/res/values/colors.xml
    This replaces the original ZalithLauncher colors entirely.
    All screens use these by default (light mode = dark by design).
-->
<resources>
    <color name="black_or_white">#000000</color>

    <!-- ── Core Backgrounds ── -->
    <color name="flint_bg">#0A0A0C</color>
    <color name="flint_surface">#111115</color>
    <color name="flint_surface2">#18181E</color>
    <color name="flint_surface3">#1E1E26</color>

    <!-- ── Borders ── -->
    <color name="flint_border">#23232E</color>
    <color name="flint_border2">#2E2E3D</color>

    <!-- ── Accent (Blue) ── -->
    <color name="flint_accent">#3B82F6</color>
    <color name="flint_accent2">#93C5FD</color>
    <color name="flint_accent_dim">#263B82F6</color>
    <color name="flint_accent_glow">#4D3B82F6</color>

    <!-- ── Text ── -->
    <color name="flint_text">#EEEDF5</color>
    <color name="flint_text_dim">#7E7D90</color>
    <color name="flint_text_mute">#3A3948</color>

    <!-- ── Status Colors ── -->
    <color name="flint_green">#34D399</color>
    <color name="flint_green_dim">#1F34D399</color>
    <color name="flint_red">#F87171</color>
    <color name="flint_yellow">#F59E0B</color>

    <!-- ── Keep legacy names working (mapped to Flint dark theme) ── -->
    <color name="background_app">#0A0A0C</color>
    <color name="background_app_error">#2D1A1A</color>
    <color name="background_overlay">#18181E</color>
    <color name="background_status_bar">#0A0A0C</color>
    <color name="background_menu_top">#111115</color>
    <color name="background_menu_top_error">#2D1A1A</color>
    <color name="background_menu_element">#3B82F6</color>
    <color name="background_ripple_effect">#3B82F6</color>

    <color name="button_background">#18181E</color>
    <color name="button_background_selected">#23232E</color>
    <color name="dialog_background">#111115</color>

    <color name="menu_bar">#111115</color>
