<?xml version="1.0" encoding="utf-8"?>
<!--
    FlintLauncher — activity_flint_splash.xml
    Place at: ZalithLauncher/src/main/res/layout/activity_flint_splash.xml

    BUG 1 FIX: background changed from #1565C0 (blue) to @color/flint_bg (black)
    Navigation bar hiding is done in FlintSplashActivity.kt
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/flint_bg">

    <!-- Logo -->
    <ImageView
        android:id="@+id/splash_logo"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:src="@mipmap/ic_launcher"
        android:alpha="0"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toTopOf="@+id/splash_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <!-- App name -->
    <TextView
        android:id="@+id/splash_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="FlintLauncher"
        android:textColor="@color/flint_text"
        android:textSize="32sp"
        android:textStyle="bold"
        android:fontFamily="@font/exo2"
        android:alpha="0"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@+id/splash_tagline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/splash_logo" />

    <!-- Tagline -->
    <TextView
        android:id="@+id/splash_tagline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Minecraft Java on Android, for everyone."
        android:textColor="@color/flint_text_dim"
        android:textSize="13sp"
        android:fontFamily="@font/exo2"
        android:alpha="0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/splash_title" />

    <!-- Accent line progress bar -->
    <ProgressBar
        android:id="@+id/splash_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="200dp"
        android:layout_height="3dp"
        android:layout_marginBottom="48dp"
        android:indeterminate="true"
        android:progressTint="@color/flint_accent"
        android:indeterminateTint="@color/flint_accent"
        android:alpha="0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Version text -->
    <TextView
        android:id="@+id/splash_version"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:textColor="@color/flint_text_mute"
        android:textSize="11sp"
        android:fontFamily="@font/exo2"
        android:alpha="0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
