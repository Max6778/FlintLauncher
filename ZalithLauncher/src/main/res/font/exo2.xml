<?xml version="1.0" encoding="utf-8"?>
<!--
    FlintLauncher — Exo 2 Font Family
    Place at: ZalithLauncher/src/main/res/font/exo2.xml

    Required TTF files in res/font/:
      - exo2_regular.ttf   (renamed from Exo2-Regular.ttf)
      - exo2_bold.ttf      (renamed from Exo2-Bold.ttf)
-->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <font
        android:font="@font/exo2_regular"
        android:fontStyle="normal"
        android:fontWeight="400"
        app:font="@font/exo2_regular"
        app:fontStyle="normal"
        app:fontWeight="400" />

    <font
        android:font="@font/exo2_bold"
        android:fontStyle="normal"
        android:fontWeight="700"
        app:font="@font/exo2_bold"
        app:fontStyle="normal"
        app:fontWeight="700" />

</font-family>
